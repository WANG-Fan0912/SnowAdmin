# 生产环境优先级
# development & production & test > .env

# title
VITE_GLOB_APP_TITLE = SnowAdmin

# 静态资源url
VITE_IMG_BASE_URL = 'https://my-image-cdn.com'

# 打包基础路径
VITE_PUBLIC_PATH = /

# 路由模式 hash | history
VITE_ROUTER_MODE = hash

# 后端服务地址（开发时的 proxy 目标，接真实后端时改成自己的服务地址）
VITE_APP_BASE_URL = http://localhost:8080

# 本地mock数据 true开启 false关闭
# ---------------- 作用范围 ----------------
# 1、是否启用 src/mock 下的本地 mock 服务
#    - true ：dev 拦截 /mock/** 请求（vite-plugin-mock 的 localEnabled）
#    - false：不再拦截，业务接口请求打到真实后端
# 2、决定 axios 的 baseURL（src/api/index.ts）
#    - true ：baseURL = ""，直接请求 /mock/xxx
#    - false：baseURL = "/api"，经 vite proxy 转发到下面的 VITE_APP_BASE_URL
# 它只决定"请求发给谁"——true 发给本地 mock，false 发给真实后端（上面的 VITE_APP_BASE_URL）
# 关掉它，就是进入接后端模式：用到哪个接口，就去 src/api/modules 里把那个接口的 url 校准成后端的真实路径(接口返回的数据结构要一致)
VITE_APP_OPEN_MOCK = true

# 路由数据源 mock | front | server
# mock   ：走 src/mock 本地 mock 接口（仅当 VITE_APP_OPEN_MOCK = true 时有效）
# front  ：走前端路由文件 src/router/frontend-routes.ts，无需后端接口，开发者维护该文件即可
# server ：走真实后端接口 /menu/getRouters，由后端返回已过滤权限、已排序的路由树
# 不配置时按 VITE_APP_OPEN_MOCK 推导：开 mock → mock，否则 → front
VITE_ROUTE_SOURCE = front